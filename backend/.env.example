# Voice agent backend settings. Every setting on ONE line.

# ---------- LLM (Groq) ----------
# Get a key at: https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_your_groq_key_here
LLM_MODEL=openai/gpt-oss-120b
# For more speed you can also try: openai/gpt-oss-20b
LLM_REASONING_EFFORT=low

# ---------- Speech-to-Text (Groq Whisper) ----------
STT_MODEL=whisper-large-v3-turbo
# Empty = auto-detect. Set to hi or en to force a language
STT_LANGUAGE=

# ---------- Sales MCP server ----------
# URL of the deployed MCP server, e.g. https://mcp.mycompany.com/mcp
MCP_SERVER_URL=http://127.0.0.1:8001/mcp
# Must be the same value as MCP_AUTH_TOKEN in mcp-server/.env
MCP_AUTH_TOKEN=change_me_same_value_as_mcp_server

# ---------- Business ----------
TIMEZONE=Asia/Kolkata
# Keep the same value as in mcp-server/.env
BUSINESS_DAY_START_HOUR=5
RESTAURANT_NAME=My Restaurant
# Shown when the help library has no answer, e.g. support phone number or email
SUPPORT_CONTACT=

# ---------- Logging / monitoring ----------
LOG_LEVEL=INFO
# text = readable, json = one JSON object per line (best for Application Insights)
LOG_FORMAT=text
# Local runs: write a rotating log file. On Azure leave empty and use Application Insights / Log stream
LOG_FILE=logs/backend.log
# Include the user's question text in logs (set false if questions may contain sensitive info)
LOG_QUESTIONS=true

# ---------- API ----------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
